# Copy to .env (read by pydantic-settings). All variables use the IWL_ prefix.
# Values shown are the defaults from src/inference_lab/config.py.
IWL_REDIS_URL=redis://localhost:6379/0
IWL_INFERENCE_MODE=MOCK
IWL_VLLM_BASE_URL=http://localhost:8000/v1
IWL_VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
IWL_WORKER_ID=worker-1
IWL_WORKER_CONCURRENCY=2
IWL_CLAIM_IDLE_MS=30000
IWL_MAX_ATTEMPTS=3
IWL_MAX_QUEUE_DEPTH=10000
IWL_API_HOST=0.0.0.0
IWL_API_PORT=8080
IWL_SCALE_MIN=1
IWL_SCALE_MAX=8
